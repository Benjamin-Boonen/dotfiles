{
  "layer": "top",
  "position": "top",
  "height": 46,
  "spacing": 4,
  "include": [
    "./workspace.jsonc"
  ],
  "modules-left": [
    "custom/cava",
    "mpris",
    "clock"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/weather",
    "custom/netgraph",
    "pulseaudio",
    "battery",
    "custom/power"
  ],
  "custom/cava": {
    "exec": "sleep 1 && cava -p ~/.config/cava/cava.ini | sed -u 's/;//g;s/0/▁/g;s/1/▂/g;s/2/▃/g;s/3/▄/g;s/4/▅/g;s/5/▆/g;s/6/▇/g;s/7/█/g'",
    "format": "{}",
    "tooltip": false
  },
  "mpris": {
    "format": "  {artist} — {title}",
    "format-paused": "  {artist} — {title}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "max-length": 40
  },
  "clock": {
    "format": "  {:%H:%M    %A %d %B}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "hyprland/workspaces": {

  "format": "{id}",
  "all-outputs": false,
  "persistent-workspaces": {
    "HDMI-A-1": [1, 2, 3, 4, 5],
    "eDP-1": [6, 7]
  },
  "on-scroll-up": "hyprctl dispatch workspace e+1",
  "on-scroll-down": "hyprctl dispatch workspace e-1"
},

/*  "network": {
    "format-wifi": "  {signalStrength}%   {bandwidthUpBytes}   {bandwidthDownBytes}",
    "format-ethernet": "  {bandwidthUpBytes}   {bandwidthDownBytes}",
    "format-disconnected": "󰖪  Offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}",
    "interval": 1,
    "on-click": "nmtui"
  },*/ 
  "custom/netgraph": {
    "exec": "~/.config/waybar/netgraph.sh",
    "format": "{} {}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  muted",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-click-right": "~/.config/hypr/scripts/SwitchAudioDevice.sh",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip-format": "{timeTo}"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false
  },
  "custom/weather": {
    "exec": "curl -s 'wttr.in/?format=%c+%t' 2>/dev/null || echo ' N/A'",
    "interval": 300,
    "format": "{}"
  }
}
